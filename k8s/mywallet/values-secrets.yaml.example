# MyWallet Secrets Configuration
# Copy this file to values-secrets.yaml and fill in your actual values
# IMPORTANT: Never commit values-secrets.yaml to git!

secrets:
  # MongoDB credentials
  mongodb:
    rootPassword: "CHANGE-ME-secure-mongodb-password"

  # Gmail OAuth credentials
  # Get these from Google Cloud Console
  gmail:
    clientId: "YOUR-CLIENT-ID.apps.googleusercontent.com"
    clientSecret: "YOUR-GMAIL-CLIENT-SECRET"
    refreshToken: "YOUR-GMAIL-REFRESH-TOKEN"

  # OpenAI API credentials
  # Get from https://platform.openai.com/api-keys
  openai:
    apiKey: "sk-YOUR-OPENAI-API-KEY"

  # Cloudflare Workers AI credentials (optional)
  # These are only needed if the worker pods need direct Cloudflare access.
  # LiteLLM credentials are managed separately via kubectl in the llm namespace:
  #   kubectl create secret generic litellm-secrets -n llm \
  #     --from-literal=CLOUDFLARE_API_TOKEN=... \
  #     --from-literal=CLOUDFLARE_API_BASE=...
  # cloudflare:
  #   apiToken: "YOUR-CLOUDFLARE-API-TOKEN"
  #   apiBase: "https://api.cloudflare.com/client/v4/accounts/YOUR-ACCOUNT-ID/ai/v1"

# Optional: Override default values
# Uncomment and modify as needed

# backend:
#   image:
#     tag: "1.0.0"  # Use specific version instead of latest

# worker:
#   image:
#     tag: "1.0.0"  # Use specific version instead of latest

# mongodb:
#   persistence:
#     size: 20Gi  # Increase storage if needed

# app:
#   gmail:
#     pubSubTopic: "projects/YOUR-GCP-PROJECT/topics/gmail-notifications"
