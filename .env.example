# Node Environment
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
# Example: http://localhost:8081,https://your-app.example.com
ALLOWED_ORIGINS=http://localhost:8081

# API Server Configuration
PORT=3000

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=email-processing-queue

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27017/mywallet?authSource=admin

# ==================== PROVIDER SELECTION ====================
# Email Provider: 'gmail' | 'outlook' (currently only gmail supported)
EMAIL_PROVIDER=gmail

# AI Provider: 'openai' | 'ollama'
# Switch between providers by changing this value - no code changes needed!
AI_PROVIDER=openai

# DB Provider: 'mongodb' | 'prisma'
# 'prisma' uses Supabase (PostgreSQL) via Prisma ORM — no code changes needed!
DB_PROVIDER=mongodb

# ==================== GMAIL CONFIGURATION ====================
# Gmail API Configuration (OAuth2)
# Get these by following the Gmail OAuth setup guide in the plan
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Gmail Sync Configuration (for real-time sync feature)
# Google Cloud Pub/Sub Configuration
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_NAME=projects/your-gcp-project-id/topics/gmail-notifications
PUBSUB_SUBSCRIPTION_NAME=gmail-notifications-sub

# Gmail Sync Feature Flag
GMAIL_SYNC_ENABLED=true

# ==================== LITELLM AI GATEWAY ====================
# When set, ALL AI calls are routed through LiteLLM instead of directly to OpenAI.
# Local (docker-compose):  http://localhost:4000/v1
# Kubernetes:              http://litellm-svc.wallet.svc.cluster.local:4000/v1
LITELLM_BASE_URL=http://localhost:4000/v1
# Optional: LiteLLM master key (set in litellm-config.yaml → LITELLM_MASTER_KEY)
LITELLM_MASTER_KEY=sk-mywallet-local

# ==================== OPENAI CONFIGURATION ====================
# OpenAI API key is passed to LiteLLM (not used directly by the worker when LITELLM_BASE_URL is set).
OPENAI_API_KEY=sk-unused-ollama-only
# Model name must match a model_name entry in litellm-config.yaml
OPENAI_MODEL=cf/llama-3.1-8b-instruct
# Deprecated: use LITELLM_BASE_URL instead. Kept for direct-OpenAI fallback.
OPENAI_ENDPOINT=

# ==================== SUPABASE / PRISMA ====================
# Used when DB_PROVIDER=prisma
# DATABASE_URL uses pgbouncer (connection pooling) — for runtime queries
# DIRECT_URL uses direct connection — for prisma migrate
DATABASE_URL="postgresql://postgres.evyjqurnmuvwygfjyqxw:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.evyjqurnmuvwygfjyqxw:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# ==================== CLOUDFLARE WORKERS AI ====================
# Get your Account ID: dash.cloudflare.com → Workers & Pages → Overview (right sidebar)
# API token: dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4/accounts/your-cloudflare-account-id/ai/v1

# ==================== OLLAMA CONFIGURATION ====================
# Ollama in k8s: http://ollama.llm.svc.cluster.local:11434
# Local dev:     http://localhost:11434
OLLAMA_BASE_URL=http://ollama.llm.svc.cluster.local:11434

# Logging
LOG_LEVEL=info
